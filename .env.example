# Copia a .env y ajusta. Valores de ejemplo, no sensibles.
POSTGRES_USER=learning
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=learning
POSTGRES_TEST_DB=learning_test
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173

# Para ejecutar la API/tests FUERA de Docker (host -> contenedor db publicado).
DATABASE_URL=postgresql://learning:change_me_local_only@localhost:5432/learning?schema=public
# Debe apuntar a una base cuyo nombre termine en _test (los tests lo exigen).
TEST_DATABASE_URL=postgresql://learning:change_me_local_only@localhost:5432/learning_test?schema=public
